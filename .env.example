# 复制为 .env 后填写；.env 已在 .gitignore 里，不会进仓库
#
# 访问密钥（openssl rand -hex 32 生成）。留空 = 不启用鉴权。
HGHUB_ACCESS_KEY=

# 可选：只允许这些来源 IP（逗号分隔）
HGHUB_ALLOW_IPS=

# 可选：放在 Nginx / Cloudflare 后面时，用 X-Forwarded-For 取真实 IP
# HGHUB_TRUST_PROXY=1

# 可选：HTTPS 部署时让 Cookie 带 Secure
# HGHUB_COOKIE_SECURE=1

# 端口（默认 8081 / 8080）
WEB_PORT=8081
PROXY_PORT=8080
