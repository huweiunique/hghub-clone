# 复制为 .env 后填写：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交到仓库。
#
# ── 访问密钥 ─────────────────────────────────────────────────────────────
# 它就是一段【任意字符串】，没有格式要求：
#   - 长度不限（建议 16 位以上，越长越难猜）
#   - 字母 / 数字 / 符号都行，但不能包含空格和换行
#
# `openssl rand -hex 32` 只是【常用的一种生成方式】（生成 64 位十六进制随机串），
# 并不是必须的。下面这些同样可以，效果没区别：
#
#   openssl rand -hex 32             → 3f2a9c...（64 个十六进制字符）
#   openssl rand -base64 24          → xK9/2mP+...（注意末尾可能有 = 和 + /）
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
#   pwsh -c "[guid]::NewGuid().ToString('N')"
#   或者你自己手打：my-home-server-2026
#
# 留空 = 不启用鉴权（服务公开可访问，仅建议内网使用）。
HGHUB_ACCESS_KEY=

# 可选：只允许这些来源 IP 访问（逗号分隔，和密钥同时生效）
HGHUB_ALLOW_IPS=

# 可选：放在 Nginx / Cloudflare 等反代后面时，用 X-Forwarded-For 取真实 IP
# HGHUB_TRUST_PROXY=1

# 可选：HTTPS 部署时让 Cookie 带 Secure
# HGHUB_COOKIE_SECURE=1

# 端口（默认 8081 网页 / 8080 播放代理）
WEB_PORT=8081
PROXY_PORT=8080
