# CI 在 Linux/macOS 上执行，脚本必须是 LF，否则会报 "bad interpreter"
*.sh text eol=lf
Dockerfile text eol=lf
docker/*.sh text eol=lf
docker-compose.yml text eol=lf

# Python / JS / YAML 统一 LF
*.py text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.md text eol=lf

# 前端页面体积大，不要让 git 尝试文本转换（会破坏内容哈希校验）
web/*.html text eol=lf
web/*.mjs text eol=lf
